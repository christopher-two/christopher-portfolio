---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroShader from '../components/HeroShader';
import ProjectCard from '../components/ProjectCard.astro';
import { projects, recognitions, skills, socialLinks } from '../data/portfolio';
import { portfolioFaq, publishedApps } from '../data/seo';
import { siteUrl } from '../data/site';
import { getGithubActivity } from '../lib/github';
import { getProjectCoverImage } from '../lib/r2';

const homeProjectsBase = projects.slice(0, 8);
const [homeCovers, githubActivity] = await Promise.all([
  Promise.all(homeProjectsBase.map((project) => getProjectCoverImage(project.r2Folder))),
  getGithubActivity('christopher-two'),
]);
const homeProjects = homeProjectsBase.map((project, index) => ({
  ...project,
  coverImage: homeCovers[index] ?? '',
}));
const faqSchema = {
  '@type': 'FAQPage',
  '@id': `${siteUrl}/landing#faq`,
  mainEntity: portfolioFaq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
const landingSchema = [
  {
    '@type': 'ProfilePage',
    '@id': `${siteUrl}/landing#profile`,
    url: `${siteUrl}/landing`,
    name: 'Christopher Two · Portfolio',
    isPartOf: { '@id': `${siteUrl}/#website` },
    mainEntity: { '@id': `${siteUrl}/bio#person` },
  },
  {
    '@type': 'ItemList',
    '@id': `${siteUrl}/landing#featured-projects`,
    name: 'Proyectos destacados de Christopher Two',
    itemListElement: homeProjects.map((project, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: project.title,
      url: `${siteUrl}/projects/${project.slug}`,
    })),
  },
  ...publishedApps.map((app) => ({
    '@type': 'SoftwareApplication',
    name: app.name,
    description: app.description,
    applicationCategory: 'MobileApplication',
    operatingSystem: 'Android',
    applicationSubCategory: app.applicationCategory,
    downloadUrl: app.href,
    url: app.href,
    creator: { '@id': `${siteUrl}/bio#person` },
  })),
  faqSchema,
];
---

<BaseLayout title="Christopher Two · Software que llega a producción" description="Portfolio de Christopher Two: productos multiplataforma con Kotlin, Android, Astro, IA y Cloudflare." schema={landingSchema}>
  <section class="hero landing-hero">
    <div class="hero-background" aria-hidden="true"><HeroShader client:load /></div>
    <div class="wrap landing-hero-layout">
      <div class="hero-content">
        <h1 class="display">Ideas que se vuelven <span class="accent">productos.</span></h1>
      </div>
      <div class="hero-bottom">
        <div class="hero-meta">
          <span class="eyebrow">Desarrollador multiplataforma · Uruapan, MX</span>
          <p class="hero-statement">Kotlin Multiplatform, Android, Astro e IA. Software diseñado para llegar a producción.</p>
        </div>
        <div class="hero-actions">
          <a class="button button-primary" href="/projects">Explorar trabajo ↗</a>
          <a class="button button-ghost" href="#contact">Hablemos ↓</a>
        </div>
      </div>
    </div>
  </section>

  <div class="ticker" aria-label="Tecnologías">
    <div class="ticker-track">
      {['Kotlin Multiplatform', 'Jetpack Compose', 'Astro', 'Cloudflare', 'Clean Architecture', 'IA On-Device', 'Ktor', 'Supabase'].map((item) => <span>{item}</span>)}
      {['Kotlin Multiplatform', 'Jetpack Compose', 'Astro', 'Cloudflare', 'Clean Architecture', 'IA On-Device', 'Ktor', 'Supabase'].map((item) => <span aria-hidden="true">{item}</span>)}
    </div>
  </div>

  <section class="section presentation-section" id="about">
    <div class="wrap presentation-grid">
      <div class="presentation-copy">
        <span class="eyebrow">La persona detrás del código</span>
        <h2 class="section-title">Hola, soy Christopher.</h2>
        <p class="presentation-lede">Desarrollador multiplataforma obsesionado con convertir problemas complejos en productos que se sienten simples.</p>
        <p>Trabajo entre el ecosistema Android, Kotlin Multiplatform y la Web. Me interesan las arquitecturas que resisten el crecimiento, las interfaces con carácter y los equipos que prefieren lanzar antes que prometer.</p>
        <a class="button button-ghost" href="/bio">Conocer mi historia ↗</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <span class="eyebrow">Selección de trabajo</span>
          <h2 class="section-title">No hago demos. Hago cosas que <em>viven.</em></h2>
        </div>
        <p class="section-note">Una selección de productos, sistemas y experimentos que han pasado de la idea a usuarios reales.</p>
      </div>
      <div class="projects-grid">
        {homeProjects.map((project, index) => <ProjectCard project={project} index={index} coverImage={project.coverImage} />)}
      </div>
      <a class="button button-primary button-spaced" href="/projects">Ver todos los proyectos ↗</a>
    </div>
  </section>

  <section class="section skills-section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <span class="eyebrow">Cómo trabajo</span>
          <h2 class="section-title">Código con criterio, no por deporte.</h2>
        </div>
        <p class="section-note">El stack cambia. La intención permanece: construir software claro, útil y difícil de romper.</p>
      </div>
      <div class="skills-list">
        {skills.map((skill) => (
          <article class="skill">
            <span class="skill-index">{skill.index} / PRINCIPIO</span>
            <div>
              <h3>{skill.title}</h3>
              <span class="skill-stack">{skill.stack}</span>
            </div>
            <p>{skill.copy}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section faq-section" id="faq">
    <div class="wrap">
      <div class="section-head">
        <div>
          <span class="eyebrow">Preguntas frecuentes</span>
          <h2 class="section-title">Respuestas directas sobre mi trabajo.</h2>
        </div>
        <p class="section-note">Una guía breve para entender el tipo de productos, tecnologías y colaboraciones que forman parte de este portfolio.</p>
      </div>
      <div class="faq-list">
        {portfolioFaq.map((item) => (
          <article class="faq-item">
            <h3>{item.question}</h3>
            <p>{item.answer}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section apps-section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <span class="eyebrow">Publicado en Google Play</span>
          <h2 class="section-title">Productos que ya puedes instalar.</h2>
        </div>
        <p class="section-note">No se quedaron en el prototipo. Estas aplicaciones están disponibles para usuarios Android.</p>
      </div>
      <div class="published-apps">
        {publishedApps.map((app) => (
          <article class={`published-app ${app.tone}`}>
            <div class="published-app-top">
              <span class="mono">{app.index} / Android</span>
              <span class="published-app-mark">{app.mark}</span>
            </div>
            <div>
              <h3>{app.name}</h3>
              <p>{app.description}</p>
            </div>
            <a class="published-app-link" href={app.href} target="_blank" rel="noreferrer">Ver en Google Play <span>↗</span></a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <span class="eyebrow">Prueba de trabajo</span>
          <h2 class="section-title">Los resultados también cuentan.</h2>
        </div>
        <p class="section-note">Reconocimientos, lanzamientos y momentos que dejaron una marca más allá del repositorio.</p>
      </div>
      <div class="recognitions">
        {recognitions.map(([number, title, issuer, copy]) => (
          <article class="recognition">
            <span class="recognition-number">{number}</span>
            <div>
              <span class="mono">{issuer}</span>
              <h3>{title}</h3>
              <p>{copy}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section github-section" aria-labelledby="github-activity-title">
    <div class="wrap">
      <div class="section-head">
        <div>
          <span class="eyebrow">Actividad pública · GitHub</span>
          <h2 class="section-title" id="github-activity-title">El trabajo sigue después del lanzamiento.</h2>
        </div>
        <p class="section-note">Una lectura breve de los repositorios que están cambiando ahora mismo.</p>
      </div>
      {githubActivity.length > 0 ? (
        <div class="github-activity-list">
          {githubActivity.map((item, index) => (
            <a class="github-activity-item" href={item.url} target="_blank" rel="noreferrer">
              <span class="github-activity-index">{String(index + 1).padStart(2, '0')}</span>
              <span class="github-activity-copy">
                <span class="github-activity-meta">{item.label} · {item.repository}</span>
                <strong>{item.title}</strong>
              </span>
              <span class="github-activity-detail">{item.detail} · {new Date(item.date).toLocaleDateString('es-MX', { day: '2-digit', month: 'short' })} ↗</span>
            </a>
          ))}
        </div>
      ) : (
        <div class="github-empty">La actividad pública no está disponible en este momento.</div>
      )}
      <a class="button button-ghost button-spaced" href="https://github.com/christopher-two" target="_blank" rel="noreferrer">Ver perfil completo ↗</a>
    </div>
  </section>

  <section class="section contact-section" id="contact">
    <div class="wrap contact-grid">
      <div>
        <span class="eyebrow">¿Tienes una idea?</span>
        <h2 class="section-title">Hagamos algo que merezca ser lanzado.</h2>
        <a class="button button-primary contact-cta" href="mailto:hola@christopher.com.mx">Escribir un correo ↗</a>
      </div>
      <div class="social-list">
        {socialLinks.map((link) => <a class="social-link" href={link.href} target={link.href.startsWith('http') ? '_blank' : undefined} rel={link.href.startsWith('http') ? 'noreferrer' : undefined}><span>{link.title}</span><span>{link.handle} ↗</span></a>)}
      </div>
    </div>
  </section>
</BaseLayout>

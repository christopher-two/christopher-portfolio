---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProject } from '../../data/portfolio';
import { getProjectMedia } from '../../lib/r2';
import { siteUrl } from '../../data/site';

export const prerender = false;

const project = getProject(Astro.params.slug ?? '');
if (!project) return Astro.redirect('/projects');

const media = await getProjectMedia(project.r2Folder);
const coverImage = media.find((item) => !item.isVideo)?.url;
const paragraphs = project.longDescription.split(/\n\n+/).filter(Boolean);
const formatInline = (text: string) => text.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
const bulletIcon = `<svg class="detail-list-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>`;
const projectSchema = [
  {
    '@type': 'CreativeWork',
    '@id': `${siteUrl}/projects/${project.slug}#project`,
    url: `${siteUrl}/projects/${project.slug}`,
    name: project.title,
    description: project.description,
    keywords: project.tags.join(', '),
    about: project.tags.map((tag) => ({ '@type': 'Thing', name: tag })),
    creator: { '@id': `${siteUrl}/bio#person` },
    isPartOf: { '@id': `${siteUrl}/projects#collection` },
    mainEntityOfPage: { '@id': `${siteUrl}/projects/${project.slug}#webpage` },
    ...(coverImage ? { image: new URL(coverImage, siteUrl).href } : {}),
    ...(project.link ? { sameAs: project.link } : {}),
  },
];
---

<BaseLayout title={`${project.title} | Christopher Two`} description={project.description} image={coverImage} imageAlt={`Imágenes del proyecto ${project.title}`} ogType="article" articleSection="Case study de software" schema={projectSchema}>
  <section class="page-intro">
    <div class="wrap">
      <span class="eyebrow">Case study · {project.categories.join(' / ')}</span>
      <h1 class="section-title">{project.title}</h1>
      <p>{project.description}</p>
      <div class="detail-meta">
        {project.tags.map((tag) => <span class="tag">{tag}</span>)}
      </div>
      {project.link && <a class="button button-primary" href={project.link} target="_blank" rel="noreferrer">Visitar proyecto ↗</a>}
    </div>
  </section>

  <article class="article">
    <p class="detail-lede">{project.description}</p>
    {paragraphs.map((paragraph) => {
      if (paragraph.startsWith('### ')) {
        return <h2>{paragraph.replace(/^### /, '')}</h2>;
      }
      const lines = paragraph.split('\n');
      const hasBullets = lines.some((line) => line.startsWith('- '));
      if (!hasBullets) {
        return <p set:html={formatInline(paragraph)} />;
      }
      const introLines: string[] = [];
      const bulletLines: string[] = [];
      for (const line of lines) {
        if (line.startsWith('- ')) {
          bulletLines.push(line.slice(2));
        } else if (bulletLines.length === 0) {
          introLines.push(line);
        } else {
          bulletLines[bulletLines.length - 1] += ` ${line}`;
        }
      }
      return (
        <>
          {introLines.length > 0 && <p set:html={formatInline(introLines.join(' '))} />}
          <ul class="detail-icon-list">
            {bulletLines.map((item) => (
              <li>
                <Fragment set:html={bulletIcon} />
                <span set:html={formatInline(item)} />
              </li>
            ))}
          </ul>
        </>
      );
    })}
    <a class="button button-ghost" href="/projects">← Volver al archivo</a>
  </article>

  {media.length > 0 && (
    <section class="media-gallery" aria-labelledby="media-gallery-title" data-media-gallery>
      <div class="media-gallery-heading">
        <span class="eyebrow">Archivo visual</span>
        <h2 id="media-gallery-title">El proyecto en uso.</h2>
        <p>{media.length} piezas · selecciona una para verla a tamaño completo.</p>
      </div>
      <div class="media-grid">
        {media.map((item, index) => (
          <button class="media-item" type="button" data-media-index={index} data-media-url={item.url} data-media-video={item.isVideo ? 'true' : 'false'} data-media-alt={`${project.title}: ${item.description}`} aria-label={`Ver ${item.isVideo ? 'video' : 'imagen'} ${index + 1} de ${media.length}`}>
            {item.isVideo ? <video src={item.url} muted playsinline preload="metadata" aria-hidden="true"></video> : <img src={item.url} alt={`${project.title}: ${item.description}`} loading="lazy" decoding="async" />}
            <span class="media-item-label">{String(index + 1).padStart(2, '0')} · Ver completo ↗</span>
          </button>
        ))}
      </div>
    </section>
  )}

  {media.length > 0 && (
    <dialog class="media-viewer" data-media-viewer aria-labelledby="media-viewer-title">
      <div class="media-viewer-shell">
        <div class="media-viewer-topbar">
          <span id="media-viewer-title" class="media-viewer-counter" data-media-counter>01 / {media.length}</span>
          <button class="media-viewer-close" type="button" data-media-close aria-label="Cerrar visor">Cerrar ×</button>
        </div>
        <div class="media-viewer-content" data-media-content></div>
        <div class="media-viewer-controls">
          <button class="button button-ghost" type="button" data-media-prev>← Anterior</button>
          <button class="button button-ghost" type="button" data-media-next>Siguiente →</button>
        </div>
      </div>
    </dialog>
  )}

  {media.length > 0 && <script>
    const gallery = document.querySelector<HTMLElement>('[data-media-gallery]');
    const viewer = document.querySelector<HTMLDialogElement>('[data-media-viewer]');
    const viewerContent = viewer?.querySelector<HTMLElement>('[data-media-content]');
    const counter = viewer?.querySelector<HTMLElement>('[data-media-counter]');
    const items = [...document.querySelectorAll<HTMLButtonElement>('[data-media-index]')];
    let activeIndex = 0;

    const setMedia = (index: number) => {
      if (!viewer || !viewerContent || !counter || items.length === 0) return;
      activeIndex = (index + items.length) % items.length;
      const item = items[activeIndex];
      const url = item.dataset.mediaUrl ?? '';
      const alt = item.dataset.mediaAlt ?? '';
      viewerContent.replaceChildren();
      if (item.dataset.mediaVideo === 'true') {
        const video = document.createElement('video');
        video.src = url;
        video.controls = true;
        video.autoplay = false;
        video.playsInline = true;
        video.setAttribute('aria-label', alt);
        viewerContent.appendChild(video);
      } else {
        const image = document.createElement('img');
        image.src = url;
        image.alt = alt;
        image.decoding = 'async';
        viewerContent.appendChild(image);
      }
      counter.textContent = `${String(activeIndex + 1).padStart(2, '0')} / ${items.length}`;
    };

    items.forEach((item) => item.addEventListener('click', () => {
      setMedia(Number(item.dataset.mediaIndex));
      viewer?.showModal();
      document.body.style.overflow = 'hidden';
    }));
    viewer?.querySelector('[data-media-close]')?.addEventListener('click', () => viewer.close());
    viewer?.querySelector('[data-media-prev]')?.addEventListener('click', () => setMedia(activeIndex - 1));
    viewer?.querySelector('[data-media-next]')?.addEventListener('click', () => setMedia(activeIndex + 1));
    viewer?.addEventListener('click', (event) => {
      if (event.target === viewer) viewer.close();
    });
    viewer?.addEventListener('close', () => {
      viewerContent?.replaceChildren();
      document.body.style.overflow = '';
    });
    document.addEventListener('keydown', (event) => {
      if (!viewer?.open) return;
      if (event.key === 'ArrowLeft') setMedia(activeIndex - 1);
      if (event.key === 'ArrowRight') setMedia(activeIndex + 1);
    });

    const markOrientation = (image: HTMLImageElement) => {
      const item = image.closest<HTMLButtonElement>('.media-item');
      if (item && image.naturalWidth > image.naturalHeight * 1.2) item.classList.add('is-landscape');
    };
    gallery?.querySelectorAll<HTMLImageElement>('.media-item img').forEach((image) => {
      if (image.complete) markOrientation(image);
      else image.addEventListener('load', () => markOrientation(image), { once: true });
    });
  </script>}
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getUnifiedTechFilters, projects } from '../../data/portfolio';
import { getProjectCoverImage } from '../../lib/r2';
import { siteUrl } from '../../data/site';

const filters = getUnifiedTechFilters(projects).slice(0, 14);
const projectsWithCovers: Array<{ project: (typeof projects)[number]; coverImage: string }> = [];

for (let index = 0; index < projects.length; index += 6) {
  const batch = projects.slice(index, index + 6);
  const batchWithCovers = await Promise.all(
    batch.map(async (project) => ({
      project,
      coverImage: project.r2Folder ? await getProjectCoverImage(project.r2Folder) : '',
    })),
  );
  projectsWithCovers.push(...batchWithCovers);
}

const projectsSchema = [
  {
    '@type': 'CollectionPage',
    '@id': `${siteUrl}/projects#collection`,
    url: `${siteUrl}/projects`,
    name: 'Proyectos · Christopher Two',
    description: 'Catálogo de productos, sistemas y experimentos desarrollados por Christopher Two.',
  },
  {
    '@type': 'ItemList',
    '@id': `${siteUrl}/projects#projects`,
    name: 'Catálogo de proyectos',
    itemListElement: projects.map((project, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: project.title,
      url: `${siteUrl}/projects/${project.slug}`,
    })),
  },
];
---

<BaseLayout title="Proyectos · Christopher Two" description="Explora productos multiplataforma, aplicaciones Android, plataformas web y sistemas desarrollados por Christopher Two." schema={projectsSchema}>
  <section class="page-intro">
    <div class="wrap">
      <span class="eyebrow">Archivo de proyectos · {projects.length} entradas</span>
      <h1 class="section-title">Trabajo que dejó el laboratorio.</h1>
      <p>Productos móviles, plataformas web, herramientas internas y experimentos. Cada proyecto es una decisión de ingeniería contada desde el resultado.</p>
      <div class="filter-row" aria-label="Tecnologías utilizadas">
        <button class="filter filter-active" type="button" data-project-filter="all" aria-pressed="true">Todos</button>
        {filters.map((filter) => <button class="filter" type="button" data-project-filter={filter} aria-pressed="false">{filter}</button>)}
      </div>
    </div>
  </section>
  <section class="section">
    <div class="wrap projects-grid">
      {projectsWithCovers.map(({ project, coverImage }, index) => <ProjectCard project={project} coverImage={coverImage} index={index} />)}
    </div>
  </section>
  <script>
    const filterButtons = document.querySelectorAll<HTMLButtonElement>('[data-project-filter]');
    const projectCards = document.querySelectorAll<HTMLElement>('[data-project-tags]');

    const updateProjectFilter = (selectedFilter: string) => {
      filterButtons.forEach((button) => {
        const isActive = button.dataset.projectFilter === selectedFilter;
        button.classList.toggle('filter-active', isActive);
        button.setAttribute('aria-pressed', String(isActive));
      });

      projectCards.forEach((card) => {
        const tags = card.dataset.projectTags?.split('|') ?? [];
        card.hidden = selectedFilter !== 'all' && !tags.includes(selectedFilter);
      });
    };

    filterButtons.forEach((button) => {
      button.addEventListener('click', () => updateProjectFilter(button.dataset.projectFilter ?? 'all'));
    });
  </script>
</BaseLayout>
